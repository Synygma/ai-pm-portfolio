# ParCare environment variables
# Copy this file to .env.local (git-ignored) and fill in what you have:
#     copy .env.example .env.local
# Every variable is optional for local development. With nothing filled in, the app
# runs on the in-memory database with seed data and the Mock AI provider.
# NEVER commit .env.local. NEVER put real personal data anywhere.

# --- App ---------------------------------------------------------------------
# Public URL of the app (used in the parent invite link and push notifications).
# Local: http://localhost:3000   Production: your Vercel URL, e.g. https://parcare.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shows the /demo page (demo clock + parent simulator) and the "Demo login" button.
# "true" for the capstone demo and local work; "false" to hide them.
DEMO_MODE=true

# Signs the login cookie when running WITHOUT Supabase (in-memory mode). Optional locally.
# Make one up (long and random), e.g. in PowerShell:
#   [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
SESSION_SECRET=

# Salt for the one-way fingerprint of the internet address stored with each terms agreement (the
# address itself is never stored). Make one up like SESSION_SECRET. Optional locally; set it on
# the deployed site and never change it afterwards.
IP_HASH_SALT=

# Admin login for /admin (the ParCare team only; not a child account). Choose any email and a
# password of at least 10 characters. Leave empty to switch the admin page off.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local in-memory database snapshot (.data/dev-db.json, dev only). Set to "off" to keep data in
# memory only (fresh sample data on every start). Reset it with:  npm run db:reset
DEV_DB_FILE=

# --- Supabase (free plan) -----------------------------------------------------
# Where: https://supabase.com -> New project -> Project Settings -> API
# Leave empty to use the in-memory database.
NEXT_PUBLIC_SUPABASE_URL=
# "anon public" key (safe in the browser; row-level security protects the data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key. SERVER ONLY, bypasses row-level security. Used by /api/tick and the seed script.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (free tier) ------------------------------------------------
# Where: https://aistudio.google.com/apikey -> Create API key
# Free-tier data may be used by Google, so only fictional data goes to it.
# Leave empty to use the deterministic Mock AI provider.
GEMINI_API_KEY=
# Model name; change it here without touching code. Check the current free models in AI Studio.
GEMINI_MODEL=gemini-2.5-flash

# --- Web Push (free, self-generated) ------------------------------------------
# Generate once with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push service, e.g. mailto:team@example.com (use a team address, not a personal one).
VAPID_SUBJECT=mailto:team@example.com

# --- Scheduler ----------------------------------------------------------------
# Shared secret that protects /api/tick. Supabase pg_cron sends it every minute.
# Make one up (long and random), e.g. in PowerShell:
#   [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
CRON_SECRET=
