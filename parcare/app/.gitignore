# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: secrets never committed; the template is
.env*
!.env.example

# raw source documents (real team names, call transcript, interview material): kept locally, not published
/docs/source/

# local in-memory database snapshot (dev only)
/.data/

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# editors / OS
.vscode/*
!.vscode/extensions.json
Thumbs.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Recorded demo video (large file; shared separately)
/demo-video/
